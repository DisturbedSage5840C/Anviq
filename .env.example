# Copy to backend/.env and fill in YOUR values. Never commit the real file.
# Names only here: no values.

APP_ENV=local                 # local | staging | prod

# WhatsApp Cloud API
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v25.0

# Data stores
DATABASE_URL=postgresql+asyncpg://anviq:anviq@localhost:5432/anviq
REDIS_URL=redis://localhost:6379/0

# LLM (needed from the LLM client onwards)
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
MODEL_OFFLINE=claude-opus-5-5

# Speech
SARVAM_API_KEY=
GOOGLE_SPEECH_API_KEY=        # only for the benchmark / fallback
STT_PROVIDER=sarvam           # sarvam | google
TTS_PROVIDER=sarvam           # sarvam | google
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Privacy (generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())")
FIELD_KEY=
PHONE_PEPPER=

SENTRY_DSN=

# Web room: browser origins allowed to call POST /web/turn (JSON list or comma-separated)
WEB_ALLOWED_ORIGINS=
