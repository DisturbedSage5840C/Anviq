# Copy to backend/.env and fill in YOUR values. Never commit the real file.
# Names only here: no values.

APP_ENV=local                 # local | staging | prod

# WhatsApp Cloud API. Still required on WHATSAPP_PROVIDER=twilio (the Meta route is then switched
# off, so long random placeholders are fine).
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v25.0
# Pilot channel while Meta business verification is pending: Twilio's WhatsApp sandbox. Leave these
# lines commented out to stay on Meta. When WHATSAPP_PROVIDER=twilio all four TWILIO_* are required.
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WEBHOOK_URL=https://<your-host>/webhook/twilio

# Data stores
DATABASE_URL=postgresql+asyncpg://anviq:anviq@localhost:5432/anviq
REDIS_URL=redis://localhost:6379/0

# LLM (needed from the LLM client onwards)
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
MODEL_OFFLINE=claude-opus-5-5
ASK_MIN_SCORE=0.05              # Ask Anviq scope gate; tune with app.evaluation.citations
MAX_MODEL_STEPS_PER_DAY=60      # paid model steps one teacher may use per IST day

# Speech
SARVAM_API_KEY=
GOOGLE_SPEECH_API_KEY=        # only for the benchmark / fallback
STT_PROVIDER=sarvam           # sarvam | google
TTS_PROVIDER=sarvam           # sarvam | google
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Privacy (generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())")
FIELD_KEY=
PHONE_PEPPER=

SENTRY_DSN=

# Web room: browser origins allowed to call POST /web/turn (JSON list or comma-separated)
WEB_ALLOWED_ORIGINS=

# Mentor dashboard feed: GET /dashboard/trends. Off until both are set.
# DASHBOARD_DATABASE_URL must log in as dashboard_ro (select on public_trends only).
# DASHBOARD_API_TOKEN: 24+ random characters, the dashboard's server sends it as a bearer token.
# DASHBOARD_DATABASE_URL=
# DASHBOARD_API_TOKEN=

# Demo mode: a "14-day" mirror cycle lasts this many minutes. Leave unset in production.
# DEMO_CYCLE_MINUTES=5
