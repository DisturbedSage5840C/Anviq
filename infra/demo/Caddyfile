# SITE_ADDRESS is a hostname (Caddy fetches and renews a free HTTPS certificate for it) or
# ":80" for plain HTTP on a laptop.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Sent on every response. HSTS makes browsers stay on HTTPS for a day (browsers ignore it over
	# plain HTTP, so a laptop on ":80" is unaffected). It is short on purpose: this demo hostname is
	# tied to a VM's IP, and a longer value would lock browsers out if the address ever changed.
	# Only the web room needs the microphone.
	header {
		Strict-Transport-Security "max-age=86400"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Evolution posts to api:8080 over the compose network, so this route never needs the internet.
	@evolution_webhook path /webhook/evolution /webhook/evolution/*
	handle @evolution_webhook {
		respond 404
	}

	# The judges' web room: static files on the same origin as /web/turn, so no CORS setup.
	redir /room /room/ permanent
	handle_path /room/* {
		root * /srv/room
		header {
			Cache-Control "no-cache"
			# The page only talks to its own origin and plays replies from blob: URLs, so anything
			# else (another API, a third-party script) is refused by the browser itself.
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
		}
		file_server
	}

	handle {
		reverse_proxy api:8080
	}
}
