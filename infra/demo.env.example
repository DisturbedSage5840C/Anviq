# Copy to infra/demo.env (gitignored) and fill in. Never commit the filled-in file.
# Generate random values with:  openssl rand -hex 24   (passwords)   openssl rand -base64 32  (keys)

# --- database (hex only, so the passwords are safe inside a URL) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- public address: a hostname pointing at this machine (e.g. 35-200-176-62.sslip.io), or :80 locally ---
SITE_ADDRESS=:80

# --- WhatsApp webhook (Meta developer app, free test number). Any strings work until Meta is set up ---
# On WHATSAPP_PROVIDER=twilio the Meta route answers 404, so these two only need to be present:
# fill them with long random strings (openssl rand -hex 24), never a guessable word.
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# --- models and speech ---
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# --- encryption: base64 of 32 random bytes each ---
FIELD_KEY=
PHONE_PEPPER=

# --- browser demo ---
# The web room's origin(s), comma separated, e.g. https://anviq-demo.vercel.app
WEB_ALLOWED_ORIGINS=
# Minutes that stand in for the 14-day mirror cycle, so a judge sees Day 1 to Day 14 in one sitting
DEMO_CYCLE_MINUTES=5

# --- optional: leave these lines out entirely (not blank) until you have the values ---
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=

# --- optional: the Twilio WhatsApp sandbox as the pilot channel (testing only, not production) ---
# Set all five together. The webhook URL must match, character for character, what you paste into
# Twilio's Sandbox settings > "When a Message Comes in", because Twilio signs that exact string.
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WEBHOOK_URL=https://35-200-176-62.sslip.io/webhook/twilio
